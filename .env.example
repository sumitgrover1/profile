# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Execution mode
# ---------------------------------------------------------------------------
# prod-readonly (default) — browse and assert, but the safety guard blocks any
#                           request that would create an order or hit a payment
#                           gateway. Transactional specs skip themselves.
# staging                 — unlocks transactional specs. Only set this when
#                           BASE_URL points at a non-production host.
TEST_ENV=prod-readonly

# Fail a spec if the guard had to block a transactional request, rather than
# blocking it silently. Leave on: a read-only spec reaching a payment endpoint
# is a bug in the spec.
STRICT_SAFETY=true

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
BASE_URL=https://www.freecharge.in

# Comma-separated extra hosts the suite may talk to. Leaving this empty means
# "do not restrict by host" (CDNs, fonts and image hosts stay reachable).
# Setting it switches the guard into strict allow-list mode.
ALLOWED_HOSTS=

# Block analytics, ads and session-replay beacons. Keeps runs fast and stops
# automated traffic polluting the product's own funnels.
BLOCK_THIRD_PARTY=true

# Slow every action down by N ms. Useful when watching a run with --headed.
SLOW_MO=0

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
# Point at an APK to install it for the run. Leave empty to test whatever build
# is already installed on the device (the easier first-run path).
ANDROID_APP_PATH=

ANDROID_APP_PACKAGE=com.freecharge.android
# Optional. Appium resolves the launcher activity when this is empty.
ANDROID_APP_ACTIVITY=

ANDROID_DEVICE_NAME=Android Emulator
# Leave empty to let Appium pick. Set when several devices are attached.
ANDROID_UDID=
ANDROID_PLATFORM_VERSION=

# noReset=true keeps app data between specs — required if you signed in by hand.
# fullReset=true reinstalls the app for a true first-run state (slow).
ANDROID_NO_RESET=true
ANDROID_FULL_RESET=false

APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# ---------------------------------------------------------------------------
# Test account
# ---------------------------------------------------------------------------
# A dedicated automation account, never a personal number. Leaving this empty
# makes every authenticated spec skip with an explanatory message.
TEST_MOBILE=

# Preferred: a fixed OTP the backend issues for allow-listed staging test
# numbers. Ask the backend team for one if it does not exist — it is the only
# clean way to automate an OTP login.
TEST_STATIC_OTP=

# Alternative: an internal endpoint that returns the last OTP for a number.
# Expected to answer GET {url}?mobile=... with {"otp":"123456"}.
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
