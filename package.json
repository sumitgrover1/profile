{
  "name": "freecharge-frontend-testing-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend test automation suite for the FreeCharge web app (www.freecharge.in) and the FreeCharge Pay Bills Android app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "browsers": "playwright install --with-deps chromium webkit",
    "test:web": "playwright test",
    "test:web:smoke": "playwright test --grep @smoke",
    "test:web:functional": "playwright test --grep @functional",
    "test:web:a11y": "playwright test --grep @a11y",
    "test:web:visual": "playwright test --grep @visual",
    "test:web:perf": "playwright test --grep @perf",
    "test:web:seo": "playwright test --grep @seo",
    "test:web:mobile": "playwright test --project=mobile-chrome",
    "test:web:headed": "playwright test --headed",
    "test:web:ui": "playwright test --ui",
    "test:web:update-snapshots": "playwright test --grep @visual --update-snapshots",
    "report:web": "playwright show-report artifacts/web/html-report",
    "test:android": "wdio run android/config/wdio.android.conf.ts",
    "test:android:smoke": "wdio run android/config/wdio.android.conf.ts --mochaOpts.grep @smoke",
    "test:android:functional": "wdio run android/config/wdio.android.conf.ts --mochaOpts.grep @functional",
    "test:android:a11y": "wdio run android/config/wdio.android.conf.ts --mochaOpts.grep @a11y",
    "verify:selectors:web": "playwright test --config=tools/verify.config.ts",
    "verify:selectors:android": "wdio run android/config/wdio.android.conf.ts --spec android/tools/verify-android-selectors.e2e.ts",
    "devices": "adb devices -l",
    "clean": "rm -rf artifacts test-results allure-results"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/appium-service": "^9.30.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.2.0",
    "axe-core": "^4.12.1",
    "dotenv": "^17.4.2",
    "expect-webdriverio": "^5.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webdriverio": "^9.30.0"
  }
}
